# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_bot_token_here

# Your personal Telegram User ID (get it from @userinfobot)
ALLOWED_USER_ID=your_telegram_user_id_here

# Paths to your outreach system
OUTREACH_BASE=/Users/elnatanalpert/claude/outreach
SCRIPTS_BASE=/Users/elnatanalpert/claude/scripts

# Claude CLI command (usually just "claude")
CLAUDE_CMD=claude

# Higgsfield AI (cloud.higgsfield.ai)
HF_API_KEY=your_api_key_id_here
HF_API_SECRET=your_api_key_secret_here
